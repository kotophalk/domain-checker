# Скопировать в .env рядом с docker-compose.yml и поправить под сервер.

# Порт на 127.0.0.1, куда смотрит reverse proxy. Для каждого инструмента свой:
# 8000 — slovostat, 8001 — itogoskaz, 8002 — domain-checker.
DOMAIN_CHECKER_PORT=8002

# Доменов в одном запросе к /api/check.
MAX_DOMAINS=20

# Проверок домена в минуту на IP и размер «ведра» (0 — выключить лимит).
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=60

# Origin'ы, которым разрешено дёргать API из браузера (для сайтов экосистемы),
# через запятую. Пусто — CORS выключен. Например: https://delosvod.ru
CORS_ALLOW_ORIGIN=

# INFO — по запросу на строку; WARNING — только нераспознанные ответы регистратур.
LOG_LEVEL=INFO
